PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=aguafixdb
DB_USER=postgres
DB_PASSWORD=secret123

# Nodemailer: MAILER_SERVICE is a well-known nodemailer service name (e.g. "gmail").
# If using Gmail, MAILER_PASS must be an App Password, not the account password.
MAILER_SERVICE=gmail
MAILER_USER=your-email@gmail.com
MAILER_PASS=your-app-password

# Fallback recipient used when no SYSTEM_USER has notifications enabled
MAINTENANCE_FALLBACK_EMAIL=cuadrilla@aguafix.local

# AWS S3: bucket where leak photos are stored (objects must be publicly readable)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_BUCKET_NAME=your-bucket-name
# Only needed for temporary credentials (e.g. AWS Academy)
# AWS_SESSION_TOKEN=
