meta {
  name: 4 - Create Report
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/reports
  body: multipartForm
  auth: none
}

body:multipart-form {
  address: Av. Siempre Viva 742
  description: Fuga de agua en la tuberia principal frente a la casa
  severity: high
  reporterPhone: +50412345678
  photo: @file(fuga.jpg)
}

assert {
  res.status: eq 201
}
