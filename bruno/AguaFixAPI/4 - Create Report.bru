meta {
  name: 4 - Create Report
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/reports
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "address": "Av. Siempre Viva 742",
    "description": "Fuga de agua en la tuberia principal frente a la casa",
    "severity": "high",
    "reporterPhone": "+50412345678"
  }
}

assert {
  res.status: eq 201
}
