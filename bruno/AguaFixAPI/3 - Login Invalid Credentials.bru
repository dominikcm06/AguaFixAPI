meta {
  name: 3 - Login Invalid Credentials
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "cuadrilla@aguafix.local",
    "password": "wrong-password"
  }
}

assert {
  res.status: eq 400
}
